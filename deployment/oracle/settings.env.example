# Use distinct settings, credentials and state for each oracle.
SLA_UID=1000
SLA_GID=1000
SLA_ORACLE_STATE=/absolute/path/to/oracle/state
SLA_ORACLE_CREDENTIALS=/absolute/path/to/oracle/credentials
