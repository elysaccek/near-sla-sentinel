SLA_ORACLE_CODE_HASH=REPLACE_WITH_FINALIZED_CODE_HASH
SLA_ORACLE_ENDPOINT=https://api.example.com/health
SLA_ORACLE_CONTROL_1=
SLA_ORACLE_CONTROL_2=
SLA_WORKER_TESTNET_RPC_URL=https://test.rpc.fastnear.com
